# Token-checking ingest gateway for IoT devices. Plain HTTP on localhost only:
# HTTPS is terminated by Tailscale Funnel in front of it (`tailscale funnel 8080`),
# so no domain or Let's Encrypt is needed. Devices POST to https://<machine>.<tailnet>.ts.net/write
# Env vars come from .env:  set -a; . ./.env; set +a; caddy run --config Caddyfile
#   TOKEN_PI5   token for the Raspberry Pi 5
#   TOKEN_TEST  token for sender.py test runs (delete the matcher when done)
# Device sends: POST https://<machine>.<tailnet>.ts.net/write  with header "Authorization: Bearer <token>"
{
	auto_https off
}

# `:8080` (no host) matches any Host header; Funnel forwards the *.ts.net name,
# and a host-specific address would silently fall through to an empty 200.
http://:8080 {
	bind 127.0.0.1

	request_body {
		max_size 64KB
	}

	# `route` keeps these lines in the order written, so the 401 only fires
	# when no token matched (plain `respond` would be reordered before reverse_proxy).
	route /write* {
		@pi5 header Authorization "Bearer {env.TOKEN_PI5}"
		reverse_proxy @pi5 localhost:9000

		@test header Authorization "Bearer {env.TOKEN_TEST}"
		reverse_proxy @test localhost:9000

		respond 401
	}

	# Everything else (including the DB consoles) is not exposed
	respond 404
}
